---
import NavBar from '../components/NavBar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索">
  <NavBar slot="header" />
  
  <div class="search-page">
    <div id="search"></div>
  </div>
</BaseLayout>

<style>
  .search-page {
    max-width: 700px;
    margin: 0 auto;
    padding-top: 90px;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 40px;
  }

  /* Pagefind UI 样式覆盖 */
  :global(.pagefind-ui) {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #3354aa;
    --pagefind-ui-text: var(--text-color, #444);
    --pagefind-ui-background: var(--bg-color, #fff);
    --pagefind-ui-border: var(--border-color, #eee);
    --pagefind-ui-tag: var(--card-bg, #f8f8f8);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
  }

  :global(.pagefind-ui .pagefind-ui__search-input) {
    font-size: 16px;
    padding: 12px 16px;
  }

  :global(.pagefind-ui .pagefind-ui__result-title) {
    font-size: 1.1em;
  }

  :global(.pagefind-ui .pagefind-ui__result-excerpt) {
    font-size: 0.95em;
    line-height: 1.6;
  }

  /* 暗黑模式 */
  :global(html[data-theme="dark"] .pagefind-ui) {
    --pagefind-ui-text: #e0e0e0;
    --pagefind-ui-background: #252525;
    --pagefind-ui-border: #3a3a3a;
    --pagefind-ui-tag: #2a2a2a;
    --pagefind-ui-primary: #5a8bff;
  }

  @media (max-width: 768px) {
    .search-page {
      padding-top: 80px;
      padding-left: 15px;
      padding-right: 15px;
    }
  }
</style>

<script>
  // Pagefind 在构建时生成，开发模式下不加载
  if (window.location.protocol !== 'file:') {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);

    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      // @ts-ignore
      new PagefindUI({ 
        element: '#search',
        showSubResults: true,
        showImages: false
      });
    };
    document.body.appendChild(script);
  } else {
    document.getElementById('search')!.innerHTML = 
      '<p style="text-align:center;color:#888;padding:40px;">搜索功能在构建后可用</p>';
  }
</script>
