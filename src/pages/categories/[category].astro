---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(post => !post.data.draft);
  
  const categorySet = new Set<string>();
  posts.forEach(post => {
    const categories = post.data.categories || [];
    categories.forEach(category => categorySet.add(category));
  });
  
  return Array.from(categorySet).map(category => ({
    params: { category },
    props: { category }
  }));
}

const allPosts = (await getCollection('posts')).filter(post => !post.data.draft);
const { category } = Astro.params;
const decodedCategory = decodeURIComponent(category!);

// 所有分类统计
const categoryCount = new Map<string, number>();
allPosts.forEach(post => {
  const categories = post.data.categories || [];
  categories.forEach(cat => {
    categoryCount.set(cat, (categoryCount.get(cat) || 0) + 1);
  });
});
const categories = Array.from(categoryCount.entries()).sort((a, b) => b[1] - a[1]);

// 筭选当前分类的文章
const posts = allPosts
  .filter(post => {
    const cats = post.data.categories || [];
    return cats.includes(decodedCategory);
  });

// 按年份和月份分组（和归档页完全一致）
const groupedPosts: Record<string, typeof posts> = {};

posts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
}).forEach((post) => {
  const date = new Date(post.data.pubDate);
  const yearMonth = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
  
  if (!groupedPosts[yearMonth]) {
    groupedPosts[yearMonth] = [];
  }
  groupedPosts[yearMonth].push(post);
});
---

<BaseLayout title={`分类：${decodedCategory} - krya`}>
  <NavBar slot="header" />
  
  <div class="col-mb-12" id="main" role="main">
    <article class="post">
      <!-- 分类区域 -->
      {categories.length > 0 && (
        <div class="archive-categories">
          <h2 class="section-title">分类</h2>
          <div class="category-list">
            {categories.map(([cat, count]) => (
              <a href={`/categories/${encodeURIComponent(cat)}`} class={`category-item${cat === decodedCategory ? ' active' : ''}`}>
                <span class="category-name">{cat}</span>
                <span class="category-count">{count}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- 归档区域 -->
      <h2 class="section-title">文章归档</h2>
      {Object.entries(groupedPosts).map(([yearMonth, posts]) => {
        const [year, month] = yearMonth.split('-');
        return (
          <div class="archive-group">
            <h3 class="archive-year">{year}年 {month}月</h3>
            <ul class="archive-list">
              {posts.map((post) => (
                <li>
                  <span class="archive-date">{formatDate(post.data.pubDate.toISOString())}</span>
                  <a href={`/post/${post.id.replace(/\.[^.]+$/, '')}`}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </article>
  </div>
</BaseLayout>

<style>
  .archive-categories {
    margin-bottom: 2em;
    padding-bottom: 1.5em;
    border-bottom: 1px solid #eee;
  }

  @media (max-width: 1023px) {
    .archive-categories {
      margin-bottom: 1.2em;
      padding-bottom: 1em;
    }
  }

  html[data-theme="dark"] .archive-categories {
    border-bottom-color: #3a3a3a;
  }

  .section-title {
    font-size: 1.2em;
    font-weight: 600;
    margin-bottom: 0.8em;
    color: #333;
  }

  html[data-theme="dark"] .section-title {
    color: #e0e0e0;
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0;
  }

  .category-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: #f5f5f5;
    border-radius: 4px;
    text-decoration: none;
    color: #4d4d4d;
    font-size: 14px;
    transition: background-color 0.2s ease;
  }

  .category-item:hover {
    background: #b3b3b3;
    color: #000;
  }

  .category-item.active {
    background: #4d4d4d;
    color: #fff;
  }

  .category-item.active .category-name {
    color: #fff;
  }

  .category-item.active .category-count {
    background: rgba(255,255,255,0.2);
    color: #fff;
  }

  html[data-theme="dark"] .category-item {
    background: #2a2a2a;
    color: #e0e0e0;
  }

  html[data-theme="dark"] .category-item:hover {
    background: #3a3a3a;
    color: #fff;
  }

  html[data-theme="dark"] .category-item.active {
    background: #e0e0e0;
    color: #1a1a1a;
  }

  html[data-theme="dark"] .category-item.active .category-name {
    color: #1a1a1a;
  }

  html[data-theme="dark"] .category-item.active .category-count {
    background: rgba(0,0,0,0.15);
    color: #333;
  }

  .category-count {
    background: #ffffff;
    color: #4f4f4f;
    padding: 5px 10px;
    border-radius: 3px;
    font-size: 1em;
  }

  html[data-theme="dark"] .category-count {
    background: #444;
    color: #aaa;
  }

  .archive-year {
    font-size: 1.1em;
    font-weight: 600;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    color: #555;
  }

  html[data-theme="dark"] .archive-year {
    color: #ccc;
  }
</style>
