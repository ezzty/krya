---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(post => !post.data.draft);
  
  const categorySet = new Set<string>();
  posts.forEach(post => {
    const categories = post.data.categories || [];
    categories.forEach(category => categorySet.add(category));
  });
  
  return Array.from(categorySet).map(category => ({
    params: { category },
    props: { category }
  }));
}

const allPosts = (await getCollection('posts')).filter(post => !post.data.draft);
const { category } = Astro.params;
const decodedCategory = decodeURIComponent(category!);

// 所有分类统计
const categoryCount = new Map<string, number>();
allPosts.forEach(post => {
  const categories = post.data.categories || [];
  categories.forEach(cat => {
    categoryCount.set(cat, (categoryCount.get(cat) || 0) + 1);
  });
});
const categories = Array.from(categoryCount.entries()).sort((a, b) => b[1] - a[1]);

const posts = allPosts
  .filter(post => {
    const categories = post.data.categories || [];
    return categories.includes(decodedCategory);
  })
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`分类：${decodedCategory} | krya`}>
  <NavBar slot="header" />
  <div class="container">
    <div class="col-mb-12" id="main" role="main">
      <article class="post">
        <!-- 分类标签导航 -->
        <div class="archive-categories">
          <div class="category-list">
            {categories.map(([cat, count]) => (
              <a href={`/categories/${encodeURIComponent(cat)}`} class={`category-item${cat === decodedCategory ? ' active' : ''}`}>
                <span class="category-name">{cat}</span>
                <span class="category-count">{count}</span>
              </a>
            ))}
          </div>
        </div>

        <h1 class="categories-title">分类：{decodedCategory}</h1>
      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map(post => (
            <article class="post-item">
              <h2 class="post-title-small">
                <a href={`/post/${post.id.replace(/\.[^.]+$/, '')}`}>{post.data.title}</a>
              </h2>
              <div class="post-meta">
                <span>{new Date(post.data.pubDate).toISOString().split('T')[0]}</span>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="no-items">该分类下暂无文章</p>
      )}
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .archive-categories {
    margin-bottom: 2em;
    padding-bottom: 1.5em;
    border-bottom: 1px solid #eee;
  }

  html[data-theme="dark"] .archive-categories {
    border-bottom-color: #3a3a3a;
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0;
  }

  .category-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: #f5f5f5;
    border-radius: 4px;
    text-decoration: none;
    color: #4d4d4d;
    font-size: 14px;
    transition: background-color 0.2s ease;
  }

  .category-item:hover {
    background: #e8e8e8;
    color: #000;
  }

  .category-item.active {
    background: #4d4d4d;
    color: #fff;
  }

  .category-item.active .category-count {
    background: rgba(255,255,255,0.2);
    color: #fff;
  }

  html[data-theme="dark"] .category-item {
    background: #2a2a2a;
    color: #e0e0e0;
  }

  html[data-theme="dark"] .category-item:hover {
    background: #3a3a3a;
    color: #fff;
  }

  html[data-theme="dark"] .category-item.active {
    background: #e0e0e0;
    color: #1a1a1a;
  }

  html[data-theme="dark"] .category-item.active .category-count {
    background: rgba(0,0,0,0.15);
    color: #333;
  }

  .category-count {
    background: #ffffff;
    color: #4f4f4f;
    padding: 5px 10px;
    border-radius: 3px;
    font-size: 1em;
  }

  html[data-theme="dark"] .category-count {
    background: #444;
    color: #aaa;
  }

  .categories-title {
    margin-top: 30px;
  }
</style>
